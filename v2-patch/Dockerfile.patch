# The TRELLIS.2 worker as a patch on the image production already runs.
#
# Dockerfile.v2 clones TRELLIS.2 at upstream HEAD, so a full rebuild to change
# the handler would also change the model code under it, and a test of the new
# image could no longer say which of the two made the difference. Handler
# changes ship here, on the exact image the endpoint is pinned to; Dockerfile.v2
# stays the recipe for deliberate full rebuilds.
ARG BASE=ghcr.io/maximilianco/trellis-voxel:v2-01e1b90f4d897f0db04289ae1fa20977b8bd784e
FROM ${BASE}

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}

COPY handler.py /workspace/handler.py

# The handler's timed loader re-implements trellis2.models.from_pretrained and
# wraps DinoV3FeatureExtractor. Fail the build, not a job, if the TRELLIS.2 in
# the base image no longer has the shape that was copied.
RUN python -m py_compile /workspace/handler.py \
    && grep -q "def from_pretrained(path: str, \*\*kwargs)" /workspace/TRELLIS.2/trellis2/models/__init__.py \
    && grep -q "model.load_state_dict(load_file(model_file), strict=False)" /workspace/TRELLIS.2/trellis2/models/__init__.py \
    && grep -q "class DinoV3FeatureExtractor" /workspace/TRELLIS.2/trellis2/modules/image_feature_extractor.py \
    && (git -C /workspace/TRELLIS.2 log -1 --format="TRELLIS.2 %H %cs" || true)
